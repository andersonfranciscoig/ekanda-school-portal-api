# Application
NODE_ENV=development
PORT=3000

# CORS — origens dos frontends (vírgula; obrigatório com cookies httpOnly)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql://ekanda:ekanda@localhost:5432/ekanda?schema=public

# JWT
JWT_SECRET=change-me-to-a-strong-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-to-a-strong-secret
# Sessão beta (cookie ekanda_beta). Se vazio, usa JWT_SECRET.
JWT_BETA_SECRET=
# Sessão beta (opcional; default = JWT_SECRET)
JWT_BETA_SECRET=change-me-to-a-strong-secret-beta

# Multicaixa Express / GPO (future)
MULTICAIXA_BASE_URL=
MULTICAIXA_API_KEY=
MULTICAIXA_MERCHANT_ID=
MULTICAIXA_WEBHOOK_SECRET=

# Payment gateway (findora | findora_test | simulated)
# findora_test = sandbox Findora e força telefone 923000000 no Express
PAYMENT_GATEWAY=simulated
FINDORA_BASE_URL=https://api.findora.cc/api/v1/opg
FINDORA_API_KEY=
FINDORA_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000

# Object storage / UploadThing
STORAGE_PROVIDER=uploadthing
UPLOADTHING_TOKEN=
UPLOADTHING_APP_ID=
UPLOAD_MAX_BYTES=5242880

# Email (future)
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# WhatsApp (future)
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# n8n (future)
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# Concierge / Ollama Cloud (ou local)
# Sem OLLAMA_ENABLED=true → parser determinístico
#
# Cloud (recomendado agora): gpt-oss:120b — conversa mais natural / inteligente
# Local (quando instalado no servidor): nemotron-3.5-lightning
# Local Apple Silicon / MLX: muse-glimmer ou muse-glimmer:30b-mlx
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_TIMEOUT_MS=90000
OLLAMA_TEMPERATURE=0.75
OLLAMA_TOP_P=0.9


