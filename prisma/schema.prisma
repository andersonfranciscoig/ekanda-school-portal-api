// ═══════════════════════════════════════════════════════════════════════════
// EKANDA — PROPOSTA FINAL DE SCHEMA (NÃO APLICAR AINDA)
// Ficheiro: prisma/schema.proposed.prisma
// O schema activo continua a ser prisma/schema.prisma até aprovação + migration.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

/// Papéis de plataforma (capacidade global da conta).
/// Distintos de SchoolMembershipRole (papel dentro de um tenant School).
enum UserRole {
  GUARDIAN
  SCHOOL_OWNER
  SCHOOL_ADMIN
  EKANDA_ADMIN
}

/// Papel do utilizador numa School específica (multi-tenancy).
enum SchoolMembershipRole {
  OWNER
  ADMIN
}

enum SchoolStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  EXPIRED
  REJECTED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum PlanCode {
  FREE
  PRESENCE
  MANAGEMENT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  MULTICAIXA_EXPRESS
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  DOCUMENT_REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ApplicationDocumentStatus {
  PENDING
  APPROVED
  REJECTED
  REQUESTED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum NotificationType {
  SYSTEM
  APPLICATION
  PAYMENT
  SUBSCRIPTION
  SCHOOL
  SECURITY
}

/// Turnos de turma / candidatura (contrato FE: Manhã/Tarde/Noite/Duplo).
enum Shift {
  MORNING
  AFTERNOON
  NIGHT
  DOUBLE
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
  ONE_TIME
}

/// Galeria — alinhado ao contrato photos/videos.
enum GalleryKind {
  PHOTO
  VIDEO
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

/// Níveis de ensino oferecidos pela School (valores DB = contrato FE).
enum EducationLevelCode {
  CRECHE      @map("creche")
  PRE_ESCOLAR @map("pre_escolar")
  PRIMARIO    @map("primario")
  I_CICLO     @map("i_ciclo")
  II_CICLO    @map("ii_ciclo")
  MEDIO       @map("medio")
}

/// Serviços de catálogo fixo (valores DB = contrato FE).
enum SchoolServiceCatalogId {
  TRANSPORTE  @map("transporte")
  CANTINA     @map("cantina")
  BIBLIOTECA  @map("biblioteca")
  LABORATORIO @map("laboratorio")
  CAMPO       @map("campo")
  INFORMATICA @map("informatica")
  INGLES      @map("ingles")
  SEGURANCA   @map("seguranca")
  ENFERMARIA  @map("enfermaria")
  EXTRA       @map("extra")
}

// ─────────────────────────────────────────────
// User & platform roles
// ─────────────────────────────────────────────

/// Identidade de pessoa: firstName/lastName no persistido.
/// API pública monta `name` e `roles[]` (não há coluna `name` nem String[] roles).
model User {
  id            String   @id @default(uuid()) @db.Uuid
  firstName     String
  lastName      String
  email         String   @unique
  phone         String?  @unique
  passwordHash  String
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Substitui o antigo User.role singular.
  platformRoles UserPlatformRole[]

  memberships              SchoolMembership[]
  students                 Student[]                  @relation("GuardianStudents")
  applicationsAsGuardian   Application[]              @relation("GuardianApplications")
  applicationStatusChanges ApplicationStatusHistory[]
  reviewedDocuments        ApplicationDocument[]      @relation("DocumentReviewer")
  favorites                Favorite[]
  reviews                  Review[]
  searches                 Search[]
  recommendations          Recommendation[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  conciergeSessions        ConciergeSession[]
  conciergeVisits          ConciergeVisit[]
  conciergeVisitsDecided   ConciergeVisit[]            @relation("ConciergeVisitDecidedBy")

  @@index([email])
  @@index([phone])
  @@map("users")
}

/// Papéis de plataforma N:N (suporta roles[] no contrato FE).
/// Ex.: GUARDIAN + SCHOOL_OWNER na mesma conta.
model UserPlatformRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  role      UserRole
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
  @@map("user_platform_roles")
}

// ─────────────────────────────────────────────
// School & onboarding
// ─────────────────────────────────────────────

model School {
  id                  String       @id @default(uuid()) @db.Uuid
  name                String
  slug                String       @unique
  description         String?
  status              SchoolStatus @default(DRAFT)
  phone               String?
  email               String?
  website             String?
  logoUrl             String?
  coverImageUrl       String?
  foundedYear         Int?
  approximateStudents Int?
  instagram           String?
  facebook            String?
  servicesConfiguredAt DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  memberships     SchoolMembership[]
  location        SchoolLocation?
  educationLevels SchoolEducationLevel[]
  classes         SchoolClass[]
  services        SchoolService[]
  price           SchoolPrice?
  gallery         SchoolGallery[]
  applications    Application[]
  subscriptions   Subscription[]
  payments        Payment[]
  favorites       Favorite[]
  reviews         Review[]
  recommendations Recommendation[]
  conciergeVisits ConciergeVisit[]

  @@index([slug])
  @@index([status])
  @@map("schools")
}

model SchoolMembership {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  schoolId  String               @db.Uuid
  role      SchoolMembershipRole
  status    MembershipStatus     @default(INVITED)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId])
  @@index([userId])
  @@index([status])
  @@map("school_memberships")
}

model SchoolLocation {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @unique @db.Uuid
  province     String
  municipality String
  neighborhood String?
  address      String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([province])
  @@index([municipality])
  @@index([province, municipality])
  @@map("school_locations")
}

model SchoolEducationLevel {
  id        String             @id @default(uuid()) @db.Uuid
  schoolId  String             @db.Uuid
  level     EducationLevelCode
  createdAt DateTime           @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, level])
  @@index([schoolId])
  @@map("school_education_levels")
}

model SchoolClass {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @db.Uuid
  classLabel String
  vacancies  Int      @default(0)
  shift      Shift
  schedule   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([schoolId])
  @@index([schoolId, isActive])
  @@map("school_classes")
}

/// Catálogo fixo por escola — sync atómico de serviceIds[].
model SchoolService {
  id        String                 @id @default(uuid()) @db.Uuid
  schoolId  String                 @db.Uuid
  serviceId SchoolServiceCatalogId
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, serviceId])
  @@index([schoolId])
  @@map("school_services")
}

/// Preços da School (MVP) — 1:1 com School.
/// Fees por nível em SchoolPriceLevel; otherFees continua global.
model SchoolPrice {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @unique @db.Uuid
  otherFees Decimal? @db.Decimal(12, 2)
  currency  String   @default("AOA") @db.VarChar(8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  levels SchoolPriceLevel[]

  @@index([schoolId])
  @@map("school_prices")
}

/// Preços por nível de ensino (min/max) dentro de um SchoolPrice.
model SchoolPriceLevel {
  id            String             @id @default(uuid()) @db.Uuid
  schoolPriceId String             @db.Uuid
  levelId       EducationLevelCode

  enrollmentFeeMin Decimal? @db.Decimal(12, 2)
  enrollmentFeeMax Decimal? @db.Decimal(12, 2)

  tuitionFeeMin Decimal? @db.Decimal(12, 2)
  tuitionFeeMax Decimal? @db.Decimal(12, 2)

  transportFeeMin Decimal? @db.Decimal(12, 2)
  transportFeeMax Decimal? @db.Decimal(12, 2)

  mealFeeMin Decimal? @db.Decimal(12, 2)
  mealFeeMax Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolPrice SchoolPrice @relation(fields: [schoolPriceId], references: [id], onDelete: Cascade)

  @@unique([schoolPriceId, levelId])
  @@index([schoolPriceId])
  @@index([levelId])
  @@map("school_price_levels")
}

model SchoolGallery {
  id        String      @id @default(uuid()) @db.Uuid
  schoolId  String      @db.Uuid
  url       String
  kind      GalleryKind
  order     Int         @default(0)
  fileName  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, order])
  @@map("school_galleries")
}

// ─────────────────────────────────────────────
// Student & Applications (fase 2 — intactos na semântica)
// ─────────────────────────────────────────────

model Student {
  id             String   @id @default(uuid()) @db.Uuid
  guardianId     String   @db.Uuid
  firstName      String
  lastName       String
  birthDate      DateTime @db.Date
  gender         Gender?
  documentNumber String?
  photoUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guardian     User          @relation("GuardianStudents", fields: [guardianId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([guardianId])
  @@index([documentNumber])
  @@map("students")
}

model Application {
  id             String            @id @default(uuid()) @db.Uuid
  schoolId       String            @db.Uuid
  studentId      String            @db.Uuid
  guardianId     String            @db.Uuid
  schoolClassId  String?           @db.Uuid
  requestedShift Shift?
  status         ApplicationStatus @default(SUBMITTED)
  notes          String?
  submittedAt    DateTime          @default(now())
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  school        School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian      User                       @relation("GuardianApplications", fields: [guardianId], references: [id], onDelete: Cascade)
  schoolClass   SchoolClass?               @relation(fields: [schoolClassId], references: [id], onDelete: SetNull)
  documents     ApplicationDocument[]
  statusHistory ApplicationStatusHistory[]

  @@index([schoolId])
  @@index([guardianId])
  @@index([studentId])
  @@index([status])
  @@index([createdAt])
  @@index([schoolId, status])
  @@map("applications")
}

model ApplicationStatusHistory {
  id              String             @id @default(uuid()) @db.Uuid
  applicationId   String             @db.Uuid
  fromStatus      ApplicationStatus?
  toStatus        ApplicationStatus
  changedByUserId String?            @db.Uuid
  reason          String?
  createdAt       DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([createdAt])
  @@map("application_status_histories")
}

model ApplicationDocument {
  id               String                    @id @default(uuid()) @db.Uuid
  applicationId    String                    @db.Uuid
  name             String
  type             String
  url              String
  mimeType         String?
  size             Int?
  status           ApplicationDocumentStatus @default(PENDING)
  reviewedByUserId String?                   @db.Uuid
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("DocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([status])
  @@map("application_documents")
}

// ─────────────────────────────────────────────
// Billing (fase 2 — currency Kz mantida até decisão Multicaixa)
// ─────────────────────────────────────────────

model Plan {
  id            String        @id @default(uuid()) @db.Uuid
  code          PlanCode      @unique
  name          String
  description   String?
  price         Decimal       @db.Decimal(12, 2)
  /// Billing legado: manter "Kz" até harmonização explícita com AOA/Multicaixa.
  currency      String        @default("Kz") @db.VarChar(8)
  billingPeriod BillingPeriod @default(MONTHLY)
  isActive      Boolean       @default(true)
  isPublic      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  features      PlanFeature[]
  subscriptions Subscription[]
  payments      Payment[]

  @@index([isActive, isPublic])
  @@map("plans")
}

model PlanFeature {
  id          String   @id @default(uuid()) @db.Uuid
  planId      String   @db.Uuid
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, code])
  @@index([planId])
  @@map("plan_features")
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  schoolId  String             @db.Uuid
  planId    String             @db.Uuid
  status    SubscriptionStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?
  autoRenew Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([schoolId])
  @@index([status])
  @@index([endDate])
  @@index([schoolId, status])
  @@map("subscriptions")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  schoolId              String        @db.Uuid
  subscriptionId        String?       @db.Uuid
  planId                String?       @db.Uuid
  amount                Decimal       @db.Decimal(12, 2)
  /// Billing legado: "Kz" até decisão de padronizar AOA no gateway.
  currency              String        @default("Kz") @db.VarChar(8)
  method                PaymentMethod @default(MULTICAIXA_EXPRESS)
  status                PaymentStatus @default(PENDING)
  externalTransactionId String?
  externalReference     String?
  paidAt                DateTime?
  failureReason         String?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscription Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan         Plan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  events       PaymentEvent[]

  @@index([schoolId])
  @@index([subscriptionId])
  @@index([status])
  @@index([externalTransactionId])
  @@index([schoolId, status])
  @@map("payments")
}

model PaymentEvent {
  id              String    @id @default(uuid()) @db.Uuid
  paymentId       String    @db.Uuid
  eventType       String
  externalEventId String?
  payload         Json
  processed       Boolean   @default(false)
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([externalEventId])
  @@index([processed])
  @@map("payment_events")
}

// ─────────────────────────────────────────────
// Marketplace / Discovery
// ─────────────────────────────────────────────

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  schoolId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([userId])
  @@index([schoolId])
  @@map("favorites")
}

model Review {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  schoolId    String   @db.Uuid
  rating      Int
  comment     String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId])
  @@index([schoolId, isPublished])
  @@map("reviews")
}

model Search {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  query     String
  filters   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("searches")
}

model Recommendation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  schoolId  String   @db.Uuid
  score     Decimal  @db.Decimal(5, 4)
  reasons   Json?
  createdAt DateTime @default(now())

  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([schoolId])
  @@index([score])
  @@map("recommendations")
}

// ─────────────────────────────────────────────
// Notifications & Audit
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entity      String
  entityId    String?
  oldData     Json?
  newData     Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// Concierge (chat + ranking + visitas)
// ─────────────────────────────────────────────

enum ConciergePhase {
  greeting
  collecting
  processing
  results
  adjusting
}

enum ConciergeMessageRole {
  user
  assistant
  system
}

enum ConciergeMessageKind {
  text
  processing
  results
  compare
  decision
  empty
  error
}

enum ConciergeVisitStatus {
  PENDING_SCHOOL_CONFIRMATION
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

model ConciergeSession {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String?        @db.Uuid
  deviceId  String?
  title     String         @default("Nova procura")
  phase     ConciergePhase @default(collecting)
  needs     Json
  resultIds String[]       @default([])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user     User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ConciergeMessage[]
  visits   ConciergeVisit[]

  @@index([userId])
  @@index([deviceId])
  @@index([updatedAt])
  @@map("concierge_sessions")
}

model ConciergeMessage {
  id         String               @id @default(uuid()) @db.Uuid
  sessionId  String               @db.Uuid
  role       ConciergeMessageRole
  kind       ConciergeMessageKind @default(text)
  content    String
  colegioIds String[]             @default([])
  createdAt  DateTime             @default(now())

  session ConciergeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("concierge_messages")
}

model ConciergeVisit {
  id               String               @id @default(uuid()) @db.Uuid
  code             String               @unique
  schoolId         String               @db.Uuid
  sessionId        String?              @db.Uuid
  userId           String?              @db.Uuid
  date             DateTime             @db.Date
  time             String               @db.VarChar(5)
  contactName      String
  contactPhone     String
  status           ConciergeVisitStatus @default(PENDING_SCHOOL_CONFIRMATION)
  rejectionReason  String?
  decidedAt        DateTime?
  decidedByUserId  String?              @db.Uuid
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session   ConciergeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  decidedBy User?             @relation("ConciergeVisitDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([sessionId])
  @@index([userId])
  @@index([code])
  @@index([status])
  @@map("concierge_visits")
}
